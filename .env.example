# Base URL of inkthread-backend (Render). https in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
# This site's public URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Ed25519 private key (PKCS#8 DER, base64) that signs platform tokens for inkthread-backend.
# Server-only: never NEXT_PUBLIC_. The backend holds the public half as
# INKTHREAD_FRONTEND_SIGNING_KEY_PUBLIC. Without it the proxy answers 503.
INKTHREAD_FRONTEND_SIGNING_KEY_PRIVATE=
